# ScreenLess local development
NODE_ENV=development
PORT=4000
JOBS_PORT=4001
ADMIN_ORIGIN=http://localhost:3000
SHOWCASE_ORIGIN=http://localhost:5173

# JWT — replace in any shared or production environment
JWT_SECRET=screenless-dev-secret-change-me
JWT_EXPIRES_IN=7d

# SQLite is the default for zero-config demos.
# Point this at Postgres when using docker-compose.
DATABASE_URL="file:./dev.db"

# Optional Postgres (docker-compose)
POSTGRES_USER=screenless
POSTGRES_PASSWORD=screenless
POSTGRES_DB=screenless
POSTGRES_PORT=5432
